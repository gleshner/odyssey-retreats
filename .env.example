PORT=3000

# SendGrid API key for the contact form (optional — the form still works
# without it, it just won't send an email). Sent over SendGrid's HTTPS API
# rather than SMTP, since GoDaddy Node.js Hosting only allows outbound
# traffic on ports 80/443 — a port-587 SMTP relay would silently fail there.
# Get a key at https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Where contact-form submissions are delivered. info@odyssey-retreats.com has
# no working mailbox yet, so point this at a real inbox until the domain has
# proper email hosting set up.
CONTACT_FORM_TO_EMAIL=your_email_here

# Must be a sender verified in your SendGrid account (Settings > Sender
# Authentication > Verify a Single Sender). Defaults to CONTACT_FORM_TO_EMAIL
# if not set.
SENDGRID_FROM_EMAIL=your_verified_sendgrid_sender_here
